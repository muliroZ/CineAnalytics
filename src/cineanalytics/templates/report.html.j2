<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Relatório de consultas – CineAnalytics</title>
<style>
  :root {
    --tela: #EDEFF2;
    --papel: #F8F9FB;
    --tinta: #1B2233;
    --ardosia: #5B6478;
    --linha: #CDD2DC;
    --vinho: #8E1B2E;
    --vinho-suave: #8E1B2E1F;
    --acerto: #2F7D4F;
    --erro: #B42318;
    --condensada: "Avenir Next Condensed", "Roboto Condensed", "Helvetica Neue", "Arial Narrow", sans-serif;
    --serifa: "Iowan Old Style", "Palatino Linotype", Palatino, "Book Antiqua", Georgia, serif;
    --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    --mono: ui-monospace, "SF Mono", "Cascadia Code", Menlo, Consolas, monospace;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --tela: #141821;
      --papel: #1B2130;
      --tinta: #E6E8EE;
      --ardosia: #9AA3B5;
      --linha: #2E3647;
      --vinho: #E0687E;
      --vinho-suave: #E0687E26;
      --acerto: #5FBF86;
      --erro: #F2786A;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    background: var(--tela);
    color: var(--tinta);
    font: 16px/1.5 var(--sans);
  }
  main { max-width: 52rem; margin: 0 auto; padding: 3.5rem 1.5rem 5rem; }
  a { color: inherit; text-decoration-color: var(--vinho); text-underline-offset: 3px; }
  a:focus-visible, summary:focus-visible { outline: 2px solid var(--vinho); outline-offset: 3px; border-radius: 2px; }

  /* Cabeçalho */
  .brand { margin: 0; color: var(--vinho); font: 600 1rem/1.2 var(--condensada); font-stretch: condensed; }
  h1 {
    margin: .25rem 0 .75rem;
    font: 700 clamp(2.4rem, 6vw, 3.6rem)/1 var(--condensada);
    font-stretch: condensed;
    letter-spacing: -0.01em;
  }
  .period { margin: 0; color: var(--ardosia); }
  .stats {
    display: flex; flex-wrap: wrap; gap: .75rem 1.75rem;
    margin: 2rem 0 0; padding: 1rem 0; border-block: 1px solid var(--linha);
  }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dt { color: var(--ardosia); font-size: .85rem; }
  .stats dd { margin: 0; font: 600 1.35rem/1.2 var(--condensada); font-stretch: condensed; font-variant-numeric: tabular-nums; }
  .stats .falha dd { color: var(--erro); }
  .models { margin: .75rem 0 0; color: var(--ardosia); font-size: .9rem; }

  h2 { margin: 0 0 1rem; font: 700 1.6rem/1.15 var(--condensada); font-stretch: condensed; }
  section, nav { margin-top: 3.5rem; }
  table.full { width: 100%; }
  .note { margin: -.5rem 0 1.25rem; color: var(--ardosia); font-size: .9rem; }

  /* Índice */
  .index ol { margin: 0; padding-left: 1.6rem; columns: 2 18rem; column-gap: 2.5rem; }
  .index li { margin: 0 0 .35rem; break-inside: avoid; }
  .index li::marker { color: var(--vinho); font-variant-numeric: tabular-nums; }
  .index .x { color: var(--erro); }

  /* Perguntas: o letreiro é o elemento marcante */
  .entry { margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--linha); }
  .entry-meta { display: flex; flex-wrap: wrap; gap: .25rem 1.1rem; margin: 0 0 .6rem; color: var(--ardosia); font-size: .85rem; }
  .entry-meta .num { color: var(--vinho); font-weight: 700; }
  .tag { padding: 0 .45rem; border-radius: 3px; background: var(--vinho-suave); color: var(--vinho); }
  .entry h3 {
    margin: 0 0 1.25rem;
    font: 700 clamp(1.6rem, 4vw, 2.25rem)/1.08 var(--condensada);
    font-stretch: condensed;
    letter-spacing: -0.005em;
    max-width: 30ch;
    text-wrap: balance;
  }
  .answer { font: 1.075rem/1.65 var(--serifa); max-width: 68ch; }
  .answer > :first-child { margin-top: 0; }
  .answer p { margin: 0 0 .9rem; }
  .answer table { font-family: var(--sans); font-size: .9rem; margin: 1rem 0; }
  .error { margin: 0; padding: .75rem 1rem; border-left: 3px solid var(--erro); background: var(--papel); }

  .evidence { margin-top: 1.75rem; padding: 1.25rem 1.25rem .5rem; background: var(--papel); border-radius: 4px; }
  figure { margin: 0 0 1rem; overflow-x: auto; }
  .chart { width: 100%; min-width: 34rem; height: auto; display: block; font-family: var(--sans); }
  .chart .lbl { fill: var(--tinta); font-size: 13px; }
  .chart .val { fill: var(--ardosia); font-size: 12px; font-variant-numeric: tabular-nums; }
  .chart .bar { fill: var(--vinho); }
  .chart .bar.neg { fill: var(--ardosia); }
  .chart .zero { stroke: var(--linha); stroke-width: 1; }

  details { margin: 0 0 .75rem; }
  summary { cursor: pointer; color: var(--ardosia); font-size: .9rem; padding: .2rem 0; }
  summary:hover { color: var(--tinta); }
  details[open] summary { margin-bottom: .5rem; }
  pre {
    margin: 0; padding: .9rem 1rem; overflow-x: auto;
    background: var(--tela); border-radius: 3px;
    font: .85rem/1.5 var(--mono);
  }
  .retry { margin: .6rem 0 0; color: var(--ardosia); font-size: .85rem; }
  .retry li { margin-bottom: .25rem; }

  .scroll { overflow-x: auto; }
  table { border-collapse: collapse; width: auto; min-width: 50%; font-size: .9rem; }
  th, td { padding: .4rem .9rem .4rem 0; text-align: left; border-bottom: 1px solid var(--linha); vertical-align: top; }
  th { font-weight: 600; color: var(--ardosia); }
  td.n, th.n { text-align: right; font-variant-numeric: tabular-nums; }
  caption { caption-side: bottom; text-align: left; padding-top: .5rem; color: var(--ardosia); font-size: .85rem; }
  .ok { color: var(--acerto); font-weight: 700; }
  .x { color: var(--erro); font-weight: 700; }

  .empty { margin-top: 3rem; font: 1.1rem/1.6 var(--serifa); }
  code.inline { font-family: var(--mono); font-size: .9em; }
  footer { margin-top: 5rem; color: var(--ardosia); font-size: .85rem; max-width: 68ch; }

  @media (max-width: 36rem) {
    main { padding-top: 2rem; }
    .evidence { padding: 1rem .9rem .25rem; margin-inline: -.4rem; }
  }
  @media print {
    :root { --tela: #fff; --papel: #F4F5F7; }
    main { max-width: none; padding: 0; }
    .entry { break-inside: avoid-page; }
    .index { display: none; }
    a { text-decoration: none; }
  }
</style>
</head>
<body>
<main>
  <header>
    <p class="brand">CineAnalytics</p>
    <h1>Relatório de consultas</h1>
    {% if inicio %}
    <p class="period">
      Perguntas feitas entre {{ inicio.strftime('%d/%m/%Y %H:%M') }} e {{ fim.strftime('%d/%m/%Y %H:%M') }}.
      Gerado em {{ gerado_em.strftime('%d/%m/%Y às %H:%M') }}.
    </p>
    {% else %}
    <p class="period">Gerado em {{ gerado_em.strftime('%d/%m/%Y às %H:%M') }}.</p>
    {% endif %}

    {% if stats.perguntas %}
    <dl class="stats">
      <div><dt>Perguntas</dt><dd>{{ fmt_int(stats.perguntas) }}</dd></div>
      <div><dt>Respondidas</dt><dd>{{ fmt_int(stats.respondidas) }}</dd></div>
      {% if stats.falhas %}<div class="falha"><dt>Sem resposta</dt><dd>{{ fmt_int(stats.falhas) }}</dd></div>{% endif %}
      <div><dt>Vindas do cache</dt><dd>{{ fmt_int(stats.cache) }}</dd></div>
      <div><dt>Requisições</dt><dd>{{ fmt_int(stats.requisicoes) }}</dd></div>
      <div><dt>Tokens</dt><dd>{{ fmt_int(stats.tokens) }}</dd></div>
      {% if stats.tempo_medio is not none %}
      <div><dt>Tempo médio</dt><dd>{{ '%.1f'|format(stats.tempo_medio)|replace('.', ',') }} s</dd></div>
      {% endif %}
    </dl>
    {% if stats.modelos %}
    <p class="models">
      Modelos que responderam:
      {% for nome, n in stats.modelos %}{{ nome }} ({{ n }}){% if not loop.last %}, {% endif %}{% endfor %}.
    </p>
    {% endif %}
    {% endif %}
  </header>

  {% if evaluation %}
  <section id="avaliacao" aria-labelledby="titulo-avaliacao">
    <h2 id="titulo-avaliacao">
      Avaliação: {{ evaluation.acertos }} de {{ evaluation.total }} perguntas corretas
      ({{ '%.0f'|format(evaluation.pct) }}%)
    </h2>
    <p class="note">
      Cada resposta do agente é comparada, pelos dados, com uma consulta de referência escrita à mão.
      Fonte: <code class="inline">{{ evaluation.arquivo }}</code>.
    </p>
    {% if evaluation.grafico %}<figure>{{ evaluation.grafico }}</figure>{% endif %}
    <div class="scroll">
      <table class="full">
        <thead><tr><th>Id</th><th>Pergunta</th><th>Resultado</th><th>Detalhe</th><th class="n">Requisições</th></tr></thead>
        <tbody>
        {% for i in evaluation.itens %}
          <tr>
            <td>{{ i.id }}</td>
            <td>{{ i.pergunta }}</td>
            <td>{% if i.passou %}<span class="ok">correta</span>{% else %}<span class="x">incorreta</span>{% endif %}</td>
            <td>{% if not i.passou %}{{ i.motivo }}{% endif %}</td>
            <td class="n">{{ i.requisicoes }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </section>
  {% endif %}

  {% if entries %}
  <nav class="index" aria-labelledby="titulo-indice">
    <h2 id="titulo-indice">Perguntas</h2>
    <ol>
      {% for e in entries %}
      <li><a href="#p{{ e.number }}">{{ e.run.pergunta }}</a>{% if not e.run.ok %} <span class="x" title="sem resposta">✗</span>{% endif %}</li>
      {% endfor %}
    </ol>
  </nav>

  {% for e in entries %}
  <article class="entry" id="p{{ e.number }}">
    <p class="entry-meta">
      <span class="num">#{{ e.number }}</span>
      <time datetime="{{ e.run.criado_em.isoformat() }}">{{ e.run.criado_em.strftime('%d/%m/%Y %H:%M') }}</time>
      {% if e.run.modelo %}<span>{{ e.run.modelo }}</span>{% endif %}
      {% if e.run.cache_hit %}
        <span class="tag">resposta do cache</span>
      {% elif e.run.requisicoes %}
        <span>{{ e.run.requisicoes }} {{ 'requisição' if e.run.requisicoes == 1 else 'requisições' }}</span>
        <span>{{ '%.1f'|format(e.run.duracao_s)|replace('.', ',') }} s</span>
      {% endif %}
    </p>
    <h3>{{ e.run.pergunta }}</h3>

    {% if e.answer_html %}
      <div class="answer">{{ e.answer_html }}</div>
    {% else %}
      <p class="error">{{ e.run.erro or 'O agente não produziu resposta.' }}</p>
    {% endif %}

    {% if e.chart or e.rows or e.sql %}
    <div class="evidence">
      {% if e.chart %}<figure>{{ e.chart }}</figure>{% endif %}
      {% if e.rows %}
      <details>
        <summary>Dados retornados ({{ e.rows|length + e.hidden_rows }} linhas)</summary>
        <div class="scroll">
          <table>
            <thead><tr>{% for c in e.columns %}<th{% if loop.index0 in e.numeric_cols %} class="n"{% endif %}>{{ c }}</th>{% endfor %}</tr></thead>
            <tbody>
            {% for row in e.rows %}
              <tr>{% for v in row %}<td{% if loop.index0 in e.numeric_cols %} class="n"{% endif %}>{{ v }}</td>{% endfor %}</tr>
            {% endfor %}
            </tbody>
            {% if e.hidden_rows %}<caption>Mais {{ e.hidden_rows }} linhas não exibidas.</caption>{% endif %}
          </table>
        </div>
      </details>
      {% endif %}
      {% if e.sql %}
      <details>
        <summary>SQL executado{% if e.failed %} (após {{ e.failed|length }} {{ 'correção' if e.failed|length == 1 else 'correções' }}){% endif %}</summary>
        <pre><code>{{ e.sql }}</code></pre>
        {% if e.failed %}
        <ul class="retry">
          {% for q in e.failed %}<li>Tentativa recusada: {{ q.error }}</li>{% endfor %}
        </ul>
        {% endif %}
      </details>
      {% endif %}
    </div>
    {% endif %}
  </article>
  {% endfor %}
  {% elif not evaluation %}
  <p class="empty">
    Nenhuma pergunta registrada ainda. Faça a primeira com
    <code class="inline">cineanalytics ask "Quais os 5 filmes mais populares?"</code>
    e gere o relatório de novo.
  </p>
  {% endif %}

  <footer>
    Os números vêm da camada Gold da CineAnalytics (cinerocket.db), consultada em modo somente leitura.
    Valores financeiros consideram apenas filmes com receita e orçamento a partir de US$ 1.000;
    os valores em reais usam o câmbio da época de cada filme.
  </footer>
</main>
<script>
  // Na impressão (ou ao salvar como PDF), mostra o conteúdo recolhido.
  window.addEventListener("beforeprint", () => {
    document.querySelectorAll("details").forEach((d) => (d.open = true));
  });
</script>
</body>
</html>
