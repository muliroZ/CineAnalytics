# OBRIGATÓRIAS
OPENROUTER_API_KEY=
CINEANALYTICS_MODELS=

# OPCIONAIS
CINEANALYTICS_DB_PATH=data/cinerocket.db
CINEANALYTICS_MAX_ROWS=50
CINEANALYTICS_QUERY_TIMEOUT_S=10
CINEANALYTICS_REQUEST_LIMIT=6
CINEANALYTICS_HISTORY_TURNS=5
CINEANALYTICS_STATE_DIR=.cineanalytics/
CINEANALYTICS_CACHE_ENABLED=true
CINEANALYTICS_REPORTS_DIR=reports/